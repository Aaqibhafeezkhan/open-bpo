{
  "name": "open-bpo",
  "version": "0.1.0",
  "private": true,
  "description": "Deploy an AI BPO floor in one afternoon",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "build": "pnpm --filter @open-bpo/mcp build && pnpm --filter @open-bpo/web build",
    "dev:api": "pnpm --filter @open-bpo/api dev",
    "dev:worker": "pnpm --filter @open-bpo/worker dev",
    "dev:web": "pnpm --filter @open-bpo/web dev",
    "demo": "node scripts/demo.mjs",
    "demo:golden": "./scripts/demo-golden-path.sh",
    "seed:sample": "./scripts/seed-sample-data.sh",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "openapi": "pnpm --filter @open-bpo/api exec tsx ../../scripts/gen-openapi.ts",
    "openapi:check": "pnpm --filter @open-bpo/api exec tsx ../../scripts/gen-openapi.ts --check"
  }
}
